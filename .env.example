# ============================================
# Insurance Policy Agent - Environment Variables
# ============================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
ROUTER_MODEL=gpt-4o-mini

# --- API Authentication ---
API_KEY=

# --- Rate Limiting ---
RATE_LIMIT="3000/minute"

# --- Supabase / PostgreSQL ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase Client (optional, for REST API) ---
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here

# --- Redis Cache (Semantic cache for KB queries) ---
REDIS_URL=redis://localhost:6379
KB_CACHE_THRESHOLD=0.89
KB_CACHE_TTL=86400

# --- Context Window ---
MAX_CONTEXT_TOKENS=4000

# --- Gradio UI ---
API_BASE_URL=http://localhost:8000
GRADIO_TIMEOUT=120

# --- Arize AX Observability ---
ARIZE_SPACE_ID=U3BhY2U6NDk4MjA6WG5xRA==
ARIZE_API_KEY=ak-ecb1c934-d3a1-4097-90cf-054c7c0f8319-wPWn3tSy2OjAGoHEgK0M0fcjBq9czRMM
ARIZE_PROJECT_NAME=policy-agent
