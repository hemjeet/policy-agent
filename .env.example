# ============================================
# Insurance Policy Agent - Environment Variables
# ============================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
CLAUDE_API_KEY=sk-your-anthropic-api-key-here

# --- LLM Models ---
ROUTER_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-v4-flash
JUDGE_MODEL=gpt-4o

# --- API Authentication ---
API_KEY=

# --- Rate Limiting ---
RATE_LIMIT="3000/minute"

# --- Supabase / PostgreSQL ---
POSTGRES_URI=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- DB Connection Pool (sync engine) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Supabase Client (optional, for REST API) ---
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here

# --- Redis Cache (reserved; current semantic cache uses pgvector) ---
REDIS_URL=redis://localhost:6379
KB_CACHE_THRESHOLD=0.89
KB_CACHE_TTL=86400

# --- PII Masking & Pseudonymization ---
# Reversible masking (default on). Disable to bypass token vault entirely.
PII_MASKING_ENABLED=true

# Defense-in-depth log redaction (default on). Pseudonymizes PII in agent.log.
PII_LOG_MASKING_ENABLED=true

# One-way pseudonymization for logs/tracing.
# Set exactly ONE of these (KMS takes precedence if both are set):
#   KMS:  create an HMAC key (KeyUsage=GENERATE_VERIFY_MAC, KeySpec=HMAC_256)
#         and put its key id, alias, or ARN here. Requires boto3 installed.
#   Local: any high-entropy secret (e.g. `openssl rand -hex 32`).
PII_KMS_KEY_ID=
PII_HMAC_KEY=
PII_KMS_MAC_ALGORITHM=
# Optional: coarse hide LLM text from Arize traces (OpenInference built-in).
# OPENINFERENCE_HIDE_INPUT_TEXT=true
# OPENINFERENCE_HIDE_OUTPUT_TEXT=true

# --- Context Window ---
MAX_CONTEXT_TOKENS=4000
MAX_ITERATIONS=5

# --- Gradio UI ---
API_BASE_URL=http://localhost:8000
GRADIO_TIMEOUT=120

# --- Arize AX Observability ---
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=policy-agent

# --- Evaluation Quality Gates ---
EVAL_ROUTER_MIN_ACCURACY=90.0
EVAL_TOOL_MIN_ACCURACY=85.0
EVAL_TOOL_ARGS_MIN_ACCURACY=85.0
EVAL_RAG_MIN_GROUNDEDNESS=3.8
EVAL_RAG_MIN_RELEVANCE=3.8
EVAL_RAG_MIN_COVERAGE=80.0
